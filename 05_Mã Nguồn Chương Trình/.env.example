# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG TRỢ LÝ HỌC VỤ DNC (RAG FASTAPI + GEMINI)
# Sao chép tệp này thành .env và điền các giá trị thực tế (KHÔNG commit .env lên Git)
# ==============================================================================

# 1. Cấu hình Ứng dụng & Máy chủ FastAPI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# 2. Cấu hình Kho lưu trữ Vector ChromaDB
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=qd580_baseline_v2

# 3. Cấu hình Mô hình Bi-Encoder Embedding
EMBEDDING_MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_MODEL_REVISION=84f9d9ada0d1a3c37557398b9ae9fcedcdf40be0

# 4. Cấu hình Google Gemini API
# Cung cấp GEMINI_API_KEY từ Google AI Studio để kết nối LLM trực tiếp.
# Nếu để trống hoặc chưa có key, hệ thống tự động hoạt động ở chế độ Offline Mock an toàn.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 5. Cấu hình Tham số RAG
RAG_TOP_K=5
